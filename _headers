# Long-cache static assets (JS/CSS are versioned via ?v=, images are content-stable)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/logo.png
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800
# HTML must always revalidate so new deploys show immediately
/index.html
  Cache-Control: public, max-age=0, must-revalidate
